      <div type="poem" xml:id="f31_canto_xxiii_il_sabato_del_villaggio_p_161">
        <pb n="161" facs="#F31161"/>
                <head>CANTO XXIII. IL SABATO DEL VILLAGGIO.</head>
        <lg>
<l n="41">Recheran l’ore, ed al travaglio usato</l>
        <l n="42">Ciascuno in suo pensier farà ritorno.</l>
        <l n="43">Garzoncello scherzoso,</l>
        <l n="44">Cotesta età fiorita</l>
        <l n="45">È come un giorno d’allegrezza pieno,</l>
        <l n="46">Giorno chiaro, sereno,</l>
        <l n="47">Che precorre <app><lem wit="#F31">a la</lem><rdg wit="#B24 #B26 #N35 #R18">alla festa</rdg></app> festa di tua vita.</l>
        <l n="48">Godi, fanciullo mio; stato soave,</l>
        <l n="49">Stagion lieta è cotesta.</l>
        <l n="50">Altro dirti non vo’; ma la tua festa</l>
        <l n="51">Ch’anco tardi a venir non ti sia grave.</l>
        </lg>
      </div>
    </body>
