  <text>
    <body>
      <div type="poem" xml:id="f31_viii_inno_ai_patriarchi_o_de_principii_del_genere_umano_p_78">
        <pb n="78" facs="#F31078"/>
                <head>VIII. INNO AI PATRIARCHI, O DE’ PRINCIPII DEL GENERE UMANO</head>
        <lg>
<l n="108">Nidi l’intima rupe, <app><lem wit="#F31">ónde</lem><rdg wit="#B24 #B26 #N35 #R18">Onde</rdg></app> <app><lem wit="#F31">ministra</lem><rdg wit="#B24 #B26 #N35 #R18">Ministra</rdg></app></l>
        <l n="109">L’irrigua valle, inopinato il giorno</l>
        <l n="110"><app><lem wit="#F31">De l’atra</lem><rdg wit="#B24 #B26 #N35 #R18">Dell’atra</rdg></app> morte incombe. <app><lem wit="#F31">Oh contra il nostro</lem><rdg wit="#B24 #B26 #N35 #R18">Contra il nostro Scellerato ardimento</rdg></app></l>
        <l n="111"><app><lem wit="#F31">Scelerato ardimento</lem><rdg wit="#B24 #B26 #N35 #R18">Contra il nostro Scellerato ardimento</rdg></app> inermi regni</l>
        <l n="112"><app><lem wit="#F31">De la</lem><rdg wit="#B24 #B26 #N35 #R18">Della saggia natura!</rdg></app> saggia <app><lem wit="#F31">natura.</lem><rdg wit="#B24 #B26 #N35 #R18">Natura!</rdg></app> I lidi e gli antri</l>
        <l n="113">E le quiete selve apre l’invitto</l>
        <l n="114">Nostro furor; le violate genti</l>
        <l n="115">Al peregrino affanno, <app><lem wit="#F31">a gl’</lem><rdg wit="#B24 #B26 #N35 #R18">Agl’ignorati</rdg></app>ignorati</l>
        <l n="116">Desiri educa; e la fugace, ignuda</l>
        <l n="117">Felicità per l’imo sole incalza . </poem></l>
        </lg>
      </div>
    </body>
