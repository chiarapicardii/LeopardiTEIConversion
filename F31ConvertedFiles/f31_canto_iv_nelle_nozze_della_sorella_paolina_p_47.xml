      <div type="poem" xml:id="f31_canto_iv_nelle_nozze_della_sorella_paolina_p_47">
        <pb n="47" facs="#F31047"/>
                <head>CANTO IV. Nelle nozze della sorella Paolina</head>
        <lg>
<l n="1">Poi che del patrio nido</l>
        <l n="2">I silenzi lasciando, e le beate</l>
        <l n="3">Larve e l’antico error, celeste dono,</l>
        <l n="4">Ch’abbella <app><lem wit="#F31">a gli</lem><rdg wit="#B24 #N35">agli occhi tuoi</rdg></app> occhi tuoi quest’ermo lido,</l>
        <l n="5">Te <app><lem wit="#F31">ne la</lem><rdg wit="#B24 #N35">nella polve</rdg></app> polve <app><lem wit="#F31">de la</lem><rdg wit="#B24 #N35">della vita</rdg></app> vita <app><lem wit="#F31">e ’l</lem><rdg wit="#B24 #N35">e il suono</rdg></app> suono</l>
        <l n="6">Tragge il destin; l’obbrobriosa etate</l>
        <l n="7"><app><lem wit="#F31">Che ’l</lem><rdg wit="#B24 #N35">Che il duro</rdg></app> duro cielo a noi prescrisse impara,</l>
        <l n="8">Sorella mia, che in gravi</l>
        <l n="9">E luttuosi tempi</l>
        <l n="10">L’infelice famiglia <app><lem wit="#F31">a l’infelice</lem><rdg wit="#B24 #N35">all’infelice</rdg></app></l>
        <l n="11">Italia accrescerai. Di forti esempi</l>
        <l n="12">Al tuo sangue provvedi. Aure soavi</l>
        <l n="13">L’empio fato interdice</l>
        <l n="14"><app><lem wit="#F31">A l’umana</lem><rdg wit="#B24 #N35">All’umana virtude</rdg></app> virtude,</l>
        <l n="15">Nè pura in gracil petto alma si chiude.</l>
        </lg>
      </div>
    </body>
