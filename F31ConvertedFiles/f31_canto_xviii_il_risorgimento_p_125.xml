    <body>
      <div type="poem" xml:id="f31_canto_xviii_il_risorgimento_p_125">
        <pb n="125" facs="#F31125"/>
                <head>CANTO XVIII Il risorgimento</head>
        <lg>
<l n="1">Credei ch’al tutto fossero</l>
        <l n="2">In me, sul fior <app><lem wit="#F31">de gli</lem><rdg wit="#B24 #B26 #N35 #R18">degli anni</rdg></app> anni,</l>
        <l n="3">Mancati i dolci affanni</l>
        <l n="4"><app><lem wit="#F31">De la</lem><rdg wit="#B24 #B26 #N35 #R18">Della mia</rdg></app> mia prima età:</l>
        <l n="5">I dolci affanni, i teneri</l>
        <l n="6">Moti del cor profondo,</l>
        <l n="7">Qualunque cosa al mondo</l>
        <l n="8">Grato il sentir ci fa.</l>
        <l n="9">Quante querele e <app><lem wit="#F31">lagrime</lem><rdg wit="#B24 #B26 #N35 #R18">lacrime</rdg></app></l>
        <l n="10">Sparsi nel novo stato,</l>
        <l n="11">Quando al mio cor gelato</l>
        <l n="12">Prima il dolor mancò!</l>
        <l n="13"><app><lem wit="#F31">Mancar</lem><rdg wit="#B24 #B26 #N35 #R18">Mancàr</rdg></app> gli usati palpiti,</l>
        <l n="14">L’amor mi venne meno,</l>
        <l n="15">E irrigidito il seno</l>
        <l n="16">Di sospirar cessò! </poem></l>
        </lg>
      </div>
