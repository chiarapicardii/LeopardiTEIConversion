  <text>
    <body>
      <div type="poem" xml:id="f31_viii_inno_ai_patriarchi_o_de_principii_del_genere_umano_p_77">
        <pb n="77" facs="#F31077"/>
                <head>VIII. INNO AI PATRIARCHI, O DE’ PRINCIPII DEL GENERE UMANO</head>
        <lg>
<l n="84">E di servaggio <app><lem wit="#F31">a l’odiata</lem><rdg wit="#B24 #B26 #N35 #R18">All’odiata</rdg></app> soma</l>
        <l n="85">Volenteroso il prode animo addisse.</l>
        <l n="86">Fu certo, fu (nè d’error vano e d’ombra</l>
        <l n="87">L’aonio canto e <app><lem wit="#F31">de la</lem><rdg wit="#B24 #B26 #N35 #R18">Della fama il grido</rdg></app> fama il grido</l>
        <l n="88">Pasce l’avida plebe) amica un tempo</l>
        <l n="89">Al sangue nostro e dilettosa e cara</l>
        <l n="90">Questa misera piaggia, ed aurea corse</l>
        <l n="91">Nostra caduca età. Non che di latte</l>
        <l n="92">Onda rigasse intemerata il fianco</l>
        <l n="93"><app><lem wit="#F31">De le</lem><rdg wit="#B24 #B26 #N35 #R18">Delle balze materne</rdg></app> balze materne, o <app><lem wit="#F31">con le greggi</lem><rdg wit="#B24 #B26 #N35 #R18">con le greggi... Il pastorel</rdg></app></l>
        <l n="94"><app><lem wit="#F31">Mista la tigre a i consueti ovili</lem><rdg wit="#B24 #B26 #N35 #R18">con le greggi... Il pastorel</rdg></app></l>
        <l n="95"><app><lem wit="#F31">E guidasse per gioco i lupi al fonte</lem><rdg wit="#B24 #B26 #N35 #R18">con le greggi... Il pastorel</rdg></app></l>
        <l n="96"><app><lem wit="#F31">Il pastorel</lem><rdg wit="#B24 #B26 #N35 #R18">con le greggi... Il pastorel</rdg></app>; ma di suo fato ignara</l>
        <l n="97">E <app><lem wit="#F31">de gli</lem><rdg wit="#B24 #B26 #N35 #R18">Degli affanni suoi</rdg></app> affanni suoi, <app><lem wit="#F31">vòta</lem><rdg wit="#B24 #B26 #N35 #R18">Vota</rdg></app> d’affanno</l>
        <l n="98">Visse l’umana <app><lem wit="#F31">stirpe</lem><rdg wit="#B24 #B26 #N35 #R18">Stirpe</rdg></app>; <app><lem wit="#F31">a le</lem><rdg wit="#B24 #B26 #N35 #R18">Alle secrete</rdg></app> <app><lem wit="#F31">secrete</lem><rdg wit="#B24 #B26 #N35 #R18">Secrete</rdg></app></l>
        <l n="99">Leggi del cielo e di natura indutto</l>
        <l n="100">Valse l’ameno error, <app><lem wit="#F31">le fraudi, il molle</lem><rdg wit="#B24 #B26 #N35 #R18">Fraudi, il molle</rdg></app></l>
        <l n="101">Pristino velo; e di sperar contenta</l>
        <l n="102">Nostra placida nave in porto ascese.</l>
        <l n="103">Tal fra le vaste californie selve</l>
        <l n="104">Nasce beata prole, a cui non sugge</l>
        <l n="105">Pallida cura il petto, a cui le membra</l>
        <l n="106">Fera tabe non <app><lem wit="#F31">dóma</lem><rdg wit="#B24 #B26 #N35 #R18">Doma</rdg></app>, e vitto il bosco, </poem></l>
        </lg>
      </div>
