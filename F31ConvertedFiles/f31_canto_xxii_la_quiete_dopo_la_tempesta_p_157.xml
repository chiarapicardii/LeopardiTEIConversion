      <div type="poem" xml:id="f31_canto_xxii_la_quiete_dopo_la_tempesta_p_157">
        <pb n="157" facs="#F31157"/>
                <head>CANTO XXII La quiete dopo la tempesta</head>
        <lg>
<l n="42" rend="indent">O natura cortese,</l>
        <l n="43">Son questi i doni tuoi,</l>
        <l n="44">Questi i diletti sono</l>
        <l n="45">Che tu porgi <app><lem wit="#F31">a i</lem><rdg wit="#N35">ai mortali</rdg></app> mortali. Uscir di pena</l>
        <l n="46">È diletto fra noi.</l>
        <l n="47">Pene tu spargi a larga mano; il duolo</l>
        <l n="48">Spontaneo sorge: e di piacer, quel tanto</l>
        <l n="49">Che per mostro e miracolo talvolta</l>
        <l n="50">Nasce d’affanno, è gran guadagno. Umana</l>
        <l n="51">Prole degna di pianto! assai felice</l>
        <l n="52">Se respirar ti lice</l>
        <l n="53">D’alcun dolor, beata</l>
        <l n="54">Se te d’ogni dolor morte risana.</l>
        </lg>
      </div>
