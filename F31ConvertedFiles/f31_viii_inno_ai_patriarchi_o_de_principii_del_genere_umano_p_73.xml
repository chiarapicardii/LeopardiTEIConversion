      <div type="poem" xml:id="f31_viii_inno_ai_patriarchi_o_de_principii_del_genere_umano_p_73">
        <pb n="73" facs="#F31073"/>
                <head>VIII. INNO AI PATRIARCHI, O DE’ PRINCIPII DEL GENERE UMANO</head>
        <lg>
<l n="1">E voi de’ figli dolorosi il canto,</l>
        <l n="2">Voi de l’umana prole incliti padri,</l>
        <l n="3">Lodando <app><lem wit="#F31">appellerà</lem><rdg wit="#B24 #B26 #N35 #R18">Ridirà</rdg></app>; molto <app><lem wit="#F31">a l’eterno</lem><rdg wit="#B24 #B26 #N35 #R18">all’eterno</rdg></app></l>
        <l n="4"><app><lem wit="#F31">De gli</lem><rdg wit="#B24 #B26 #N35 #R18">degli astri agitator</rdg></app> astri agitator più cari, e molto</l>
        <l n="5">Di noi men lacrimabili <app><lem wit="#F31">ne l’alma</lem><rdg wit="#B24 #B26 #N35 #R18">nell’alma</rdg></app></l>
        <l n="6">Luce prodotti. Immedicati affanni</l>
        <l n="7">Al misero mortal, nascere al pianto,</l>
        <l n="8">E <app><lem wit="#F31">de l’etereo</lem><rdg wit="#B24 #B26 #N35 #R18">dell’etereo</rdg></app> lume assai più dolci</l>
        <l n="9">Sortir l’opaca tomba e <app><lem wit="#F31">’l</lem><rdg wit="#B24 #B26 #N35 #R18">il fato estremo</rdg></app> fato estremo,</l>
        <l n="10">Non <app><lem wit="#F31">la diva pietà, non l’equa</lem><rdg wit="#B24 #B26 #N35 #R18">la pietà, non la dritta</rdg></app> impose</l>
        <l n="11">Legge del <app><lem wit="#F31">cielo</lem><rdg wit="#B24 #B26 #N35 #R18">del cielo</rdg></app>. E se di vostro antico</l>
        <l n="12">Error che l’uman seme <app><lem wit="#F31">a la</lem><rdg wit="#B24 #B26 #N35 #R18">alla tiranna</rdg></app> tiranna </poem></l>
        </lg>
      </div>
