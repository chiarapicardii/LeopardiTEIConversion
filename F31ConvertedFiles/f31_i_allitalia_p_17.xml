        <pb n="17" facs="#F31017"/>
                <head>I. ALL'ITALIA.</head>
        <lg>
<l n="137">Così la vereconda</l>
        <l n="138">Fama del vostro vate appo i futuri</l>
        <l n="139">Possa, volendo i numi,</l>
        <l n="140">Tanto durar quanto la vostra duri. </poem></l>
        </lg>
      </div>
