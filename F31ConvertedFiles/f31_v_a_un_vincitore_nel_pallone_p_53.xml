    <body>
      <div type="poem" xml:id="f31_v_a_un_vincitore_nel_pallone_p_53">
        <pb n="53" facs="#F31053"/>
                <head>V. A UN VINCITORE NEL PALLONE.</head>
        <lg>
<l n="1">Di gloria il viso e la gioconda voce,</l>
        <l n="2">Garzon bennato, apprendi,</l>
        <l n="3">E quanto al femminile ozio sovrasti</l>
        <l n="4">La sudata virtude. Attendi attendi,</l>
        <l n="5">Magnanimo campion (s’<app><lem wit="#F31">a la</lem><rdg wit="#B24 #B26 #N35 #R18">s’alla veloce</rdg></app> veloce</l>
        <l n="6">Piena <app><lem wit="#F31">de gli</lem><rdg wit="#B24 #B26 #N35 #R18">degli anni il</rdg></app> anni il tuo valor contrasti</l>
        <l n="7">La spoglia di tuo nome), attendi <app><lem wit="#F31">e ’l</lem><rdg wit="#B24 #B26 #N35 #R18">attendi e il core</rdg></app> core</l>
        <l n="8">Movi ad alto desio. Te l’echeggiante</l>
        <l n="9">Arena <app><lem wit="#F31">e ’l</lem><rdg wit="#B24 #B26 #N35 #R18">e il circo</rdg></app> circo, e te fremendo appella</l>
        <l n="10"><app><lem wit="#F31">A i</lem><rdg wit="#B24 #B26 #N35 #R18">Ai fatti</rdg></app> fatti illustri il popolar favore;</l>
        <l n="11">Te rigoglioso <app><lem wit="#F31">de l’età novella</lem><rdg wit="#B24 #B26 #N35 #R18">dell’età novella</rdg></app></l>
        <l n="12">Oggi la patria cara</l>
        <l n="13">Gli antichi esempi a rinnovar prepara.</l>
        <l n="14"><app><lem wit="#F31">Non del barbaro</lem><rdg wit="#B24 #B26 #N35 #R18">Del barbarico</rdg></app> sangue in Maratona</l>
        <l n="15"><app><lem wit="#F31">Tinse l’invitta</lem><rdg wit="#B24 #B26 #N35 #R18">Non colorò la</rdg></app> destra</l>
        <l n="16"><app><lem wit="#F31">Que’</lem><rdg wit="#B24 #B26 #N35 #R18">Quei</rdg></app> che gli atleti ignudi <app><lem wit="#F31">e ’l</lem><rdg wit="#B24 #B26 #N35 #R18">e il campo</rdg></app> campo eleo,</l>
        </lg>
      </div>
