      <div type="poem" xml:id="f31_vii_alla_primavera_o_delle_favole_antiche_p_69">
        <pb n="69" facs="#F31069"/>
                <head>VII. ALLA PRIMAVERA, O DELLE FAVOLE ANTICHE.</head>
        <lg>
<l n="87">Le meste anime educa;</l>
        <l n="88">Tu le cure infelici e i fati indegni</l>
        <l n="89">Tu de’ mortali ascolta,</l>
        <l n="90">Vaga <app><lem wit="#F31">natura,</lem><rdg wit="#B24 #B26 #N35 #R18">Vaga natura,</rdg></app> e la favilla antica</l>
        <l n="91">Rendi <app><lem wit="#F31">a lo spirto</lem><rdg wit="#B24 #B26 #N35 #R18">allo spirto</rdg></app> mio; se tu pur vivi,</l>
        <l n="92">E se de’ nostri affanni</l>
        <l n="93">Cosa veruna in ciel, se <app><lem wit="#F31">ne l’aprica</lem><rdg wit="#B24 #B26 #N35 #R18">nell’aprica</rdg></app></l>
        <l n="94">Terra s’alberga o <app><lem wit="#F31">ne l’equoreo</lem><rdg wit="#B24 #B26 #N35 #R18">nell’equoreo</rdg></app> seno,</l>
        <l n="95">Pietosa no, ma spettatrice almeno.</l>
        </lg>
      </div>
    </body>
