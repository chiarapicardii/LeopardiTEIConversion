  <text>
    <body>
      <div type="poem" xml:id="f31_vi_bruto_minore_p_57">
        <pb n="57" facs="#F31057"/>
                <head>VI. BRUTO MINORE.</head>
        <lg>
<l n="1">Poi che divelta, <app><lem wit="#F31">ne la</lem><rdg wit="#B24 #B26 #N35 #R18">nella tracia</rdg></app> la tracia polve</l>
        <l n="2">Giacque, ruina immensa,</l>
        <l n="3">L’italica virtute, onde <app><lem wit="#F31">a le</lem><rdg wit="#B24 #B26 #N35 #R18">Alle valli</rdg></app> valli</l>
        <l n="4">D’Esperia verde, e al tiberino lido,</l>
        <l n="5">Il calpestio de’ barbari cavalli</l>
        <l n="6">Prepara il fato, e <app><lem wit="#F31">da le</lem><rdg wit="#B24 #B26 #N35 #R18">Dalle selve</rdg></app> selve ignude,</l>
        <l n="7">Cui l’Orsa algida preme,</l>
        <l n="8">A spezzar le romane inclite mura</l>
        <l n="9">Chiama i gotici brandi;</l>
        <l n="10">Sudato, e molle di fraterno sangue,</l>
        <l n="11">Bruto per l’atra notte in erma sede,</l>
        <l n="12">Fermo già di morir, gl’inesorandi</l>
        <l n="13">Numi e l’averno accusa,</l>
        <l n="14">E di feroci note</l>
        <l n="15">Invan la sonnolenta aura percote.</l>
        <l n="16">Stolta virtù, le cave <app><lem wit="#F31">nebbie, i campi</lem><rdg wit="#B24 #B26 #N35 #R18">Nebbie,... scole,</rdg></app></l>
        <l n="17"><app><lem wit="#F31">De l’inquiete larve</lem><rdg wit="#B24 #B26 #N35 #R18">Nebbie,... scole,</rdg></app></l>
        </lg>
      </div>
    </body>
