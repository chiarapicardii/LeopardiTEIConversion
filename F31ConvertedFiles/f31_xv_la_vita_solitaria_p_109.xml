  <text>
    <body>
      <div type="poem" xml:id="f31_xv_la_vita_solitaria_p_109">
        <pb n="109" facs="#F31109"/>
                <head>XV. LA VITA SOLITARIA.</head>
        <lg>
<l n="94">Che lieti colli e spaziosi campi</l>
        <l n="95">M’apri <app><lem wit="#F31">a la</lem><rdg wit="#B24 #B26 #N35 #R18">alla vista</rdg></app> vista. Ed <app><lem wit="#F31">io soleva ancora</lem><rdg wit="#B24 #B26 #N35 #R18">ancor io soleva</rdg></app>,</l>
        <l n="96">Bench’innocente io fossi, il tuo vezzoso</l>
        <l n="97">Raggio accusar <app><lem wit="#F31">ne gli</lem><rdg wit="#B24 #B26 #N35 #R18">negli abitati</rdg></app> abitati lochi,</l>
        <l n="98">Quand’ei m’offriva al guardo <app><lem wit="#F31">umano</lem><rdg wit="#B24 #B26 #N35 #R18">umano,</rdg></app> e quando</l>
        <l n="99">Scopriva umani aspetti al guardo mio.</l>
        <l n="100">Or sempre loderollo, o ch’io ti miri</l>
        <l n="101">Veleggiar tra le nubi, o che serena</l>
        <l n="102">Dominatrice <app><lem wit="#F31">de l’etereo</lem><rdg wit="#B24 #B26 #N35 #R18">dell’etereo</rdg></app>campo,</l>
        <l n="103">Questa flebil riguardi umana sede.</l>
        <l n="104">Me spesso rivedrai solingo e muto</l>
        <l n="105">Errar pe’ boschi e per le verdi rive,</l>
        <l n="106">O seder sovra l’erbe, assai contento</l>
        <l n="107">Se <app><lem wit="#F31">lena e core</lem><rdg wit="#B24 #B26 #N35 #R18">core e lena</rdg></app> a sospirar m’avanza. </poem></l>
        </lg>
      </div>
    </body>
